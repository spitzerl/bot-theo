DISCORD_BOT_TOKEN=MTI0...votre_token_secret_discord_ici...

# 2. Clé API Google Gemini
# Clé gratuite et illimitée en 30 secondes sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...votre_cle_gemini_ici...
