# ==============================================================================
# Variables d'environnement pour le Bot Théo Schneider (Docker & Dockhand)
# ==============================================================================

# 1. Token du Bot Discord
# Récupérable sur : https://discord.com/developers/applications (Onglet "Bot" -> "Reset Token")
# IMPORTANT : Cochez impérativement "MESSAGE CONTENT INTENT" dans l'onglet Bot !
DISCORD_BOT_TOKEN=MTI0...votre_token_secret_discord_ici...

# 2. Clé API Google Gemini (optionnel si vous utilisez Groq)
# Clé gratuite sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...votre_cle_gemini_ici...

# 3. Clé API Groq AI (RECOMMANDÉ POUR 0 QUOTA / 0 BLOCAGE - GRATUIT)
# Obtenez une clé gratuite en 15 secondes sur : https://console.groq.com/keys
# Modèle ultra-rapide Llama 3.3 70B sans aucune limitation régionale.
GROQ_API_KEY=gsk_...votre_cle_groq_ici...
